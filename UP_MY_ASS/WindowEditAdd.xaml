<Window x:Class="UP_MY_ASS.WindowEditAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_MY_ASS"
        mc:Ignorable="d"
        Title="WindowEditAdd" Height="530" Width="800" Background="LightGray" FontSize="16">
    <Grid>
        <StackPanel Orientation="Vertical" DockPanel.Dock="Right">
            <TextBlock Text="Название:" Margin="3" FontWeight="DemiBold"/>
            <TextBox Text="{Binding Name}" Padding="5" Margin = "5"/>

            <TextBlock Text="Преподаватель:" Margin="3" FontWeight="DemiBold"/>
            <TextBox Text="{Binding Courser}" Padding="5" Margin = "5"/>

            <TextBlock Text="Категория:" Margin="3" FontWeight="DemiBold"/>
            <ComboBox Name="comBoxCategories" SelectedItem="{Binding Category}"  Padding="5" Margin = "5"/>
                
            <TextBlock Text="Описание:" Margin="3" FontWeight="DemiBold"/>
            <TextBox Text="{Binding Description}"  Padding="5" Margin = "5"/>            
                
            <TextBlock Text="Цена:" Margin="3" FontWeight="DemiBold"/>
            <TextBox Text="{Binding Price}" Padding="5" Margin = "5"/>

            <DockPanel LastChildFill="False">
                <Button Click="buttDone_Click" x:Name="buttDone" Content="Изменить" Margin="5" Padding="5" DockPanel.Dock="Left"/>
                <Button Click="buttQuit_Click" x:Name="buttQuit" Content="Выход" Margin="5" Padding="5" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
