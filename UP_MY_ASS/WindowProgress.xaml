<Window x:Class="UP_MY_ASS.WindowProgress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_MY_ASS"
        mc:Ignorable="d"
        Title="WindowProgress" Height="450" Width="800">
    <Grid>
        <StackPanel x:Name="stackPanelItemsControl" Orientation="Vertical">
            <ScrollViewer Height="350">
                <ItemsControl Name="itemsProgresses">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" MouseDown="StackPanel_EditMouseDown">
                                <TextBlock Text="{Binding UserName}"/>
                                <TextBlock Text="{Binding LessonName}"/>
                                <TextBlock Text="{Binding Status, StringFormat=Статус: {0}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Click="buttProgressAdd_Click" Name="buttProgressAdd" Content="Добавить" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>
