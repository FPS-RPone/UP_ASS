<Window x:Class="UP_MY_ASS.WindowProgressEditAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_MY_ASS"
        mc:Ignorable="d"
        Title="Работа с курсом" Height="320" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" DockPanel.Dock="Right">
            <TextBlock Text="Пользователь:" Margin="3" FontWeight="DemiBold"/>
            <ComboBox x:Name="comboxUsers" DisplayMemberPath="Name" SelectedItem="{Binding User}" Padding="5" Margin = "5"/>

            <TextBlock x:Name="textBlockCategory" Text="Lesson" Margin="3" FontWeight="DemiBold"/>
            <ComboBox Name="comboxLessons" SelectedItem="{Binding Lesson}" DisplayMemberPath="Name" Padding="5" Margin = "5"/>
            
            <TextBlock Text="Статус" Margin="3" FontWeight="DemiBold"/>
            <ComboBox Name="comboxStatus" SelectedItem="{Binding Status}" Padding="5" Margin = "5"/>
            
            <DockPanel LastChildFill="False">
                <Button Click="buttDone_Click" x:Name="buttDone" Content="Изменить" Margin="5" Padding="5" DockPanel.Dock="Left"/>
                <Button Click="buttQuit_Click" x:Name="buttQuit" Content="Выход" Margin="5" Padding="5" DockPanel.Dock="Right"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
