<Window x:Class="UP_MY_ASS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP_MY_ASS"
        mc:Ignorable="d"
        Title="Вход" FontSize="16" Height="450" Width="800" Background="LightGray">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Логин" Width="600" Padding="5" Margin="5" FontWeight="DemiBold"/>
            <TextBox Text="Admin" Name="tBoxLogin" Padding="5" Margin="5"/>
            
            <TextBlock Text="Пароль" Width="600" Padding="5" Margin="5" FontWeight="DemiBold"/>
            <TextBox Text="Admin" Name="tBoxPassword" Padding="5" Margin="5"/>

            <DockPanel LastChildFill="False">
                <Button Name="buttLogin" Click="buttLogin_Click" Content="Войти" Width="100" Padding="5" Margin="10" HorizontalAlignment="Left" DockPanel.Dock="Left"/>
                <Button Name="buttQuit" Click="buttQuit_Click" Content="Выйти" Width="100" Padding="5" Margin="10" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
            
            <Button Name="buttSignInAsGuest" Click="buttSignInAsGuest_Click" Content="Войти как гость" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="5" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
